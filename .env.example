# ─── Database (any JDBC store) ─────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/app
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ─── Redis (local) ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# ─── Cache ─────────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_NAME=cache
CACHE_TTL=300

# ─── Sentry (optional — disabled when unset) ──────────────────────────────
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENABLED=true

# ─── Server ────────────────────────────────────────────────────────────────
# PORT=8080
